{
  "name": "mister-chameleon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "dev:stripe": "stripe listen --forward-to localhost:3000/api/webhooks/stripe",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:summary": "node scripts/lint-summary.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "verify": "eslint --quiet && npm run typecheck && npm test",
    "test": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=dot --test './tests/**/*.test.ts'",
    "test:cms": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=dot --test './tests/cms/*.test.ts'",
    "test:personalization": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=dot --test './tests/personalization/*.test.ts'",
    "test:release-check": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=dot --test './tests/personalization/golden-flows.test.ts' './tests/billing/billing-flow.test.ts'",
    "studio": "cd apps/studio && npm run dev",
    "studio:install": "cd apps/studio && npm install",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "previews:shots": "node scripts/generate-set-previews.mjs",
    "previews": "npm run build-storybook && npm run previews:shots",
    "backup": "tsx scripts/backup.ts",
    "backup:no-sanity": "tsx scripts/backup.ts --no-sanity",
    "restore": "tsx scripts/restore.ts",
    "seed:variants": "npx tsx cms/seed/platform-seed.ts",
    "seed:variants:dry": "npx tsx cms/seed/platform-seed.ts --dry-run",
    "seed:marketing": "npx tsx cms/seed/marketing-site-seed.ts",
    "seed:marketing:dry": "npx tsx cms/seed/marketing-site-seed.ts --dry-run",
    "upload:logos": "npx tsx cms/seed/upload-logos.ts",
    "upload:logos:dry": "npx tsx cms/seed/upload-logos.ts --dry-run",
    "seed:all": "npm run seed:variants && npm run seed:marketing",
    "deploy:seed": "npm run build && npm run seed:all",
    "test:billing": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=dot --test './tests/billing/*.test.ts'",
    "test:watch": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=spec --watch --test './tests/**/*.test.ts'",
    "test:verbose": "NODE_ENV=test node --experimental-transform-types --loader ./tests/loader.mjs --test-reporter=spec --test './tests/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.1",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@sanity/client": "^7.17.0",
    "@supabase/supabase-js": "^2.99.1",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.2",
    "next": "^16.2.1",
    "nodemailer": "^8.0.5",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "sanity": "^5.15.0",
    "stripe": "^22.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.1.1",
    "@storybook/addon-a11y": "^10.3.3",
    "@storybook/addon-docs": "^10.3.3",
    "@storybook/addon-onboarding": "^10.3.3",
    "@storybook/addon-vitest": "^10.3.3",
    "@storybook/nextjs-vite": "^10.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4.1.2",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "eslint-plugin-storybook": "^10.3.3",
    "playwright": "^1.61.1",
    "sharp": "^0.35.2",
    "storybook": "^10.3.3",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
  }
}
