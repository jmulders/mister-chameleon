# ── Mister Chameleon — Environment Variables ──────────────────────────────────
#
# Copy this file to .env.local and fill in the values for your environment.
# Never commit .env.local to version control.
#
# Convention:
#   Uncommented = required or strongly-recommended default
#   Commented   = optional (the app works without it, or it has a safe fallback)
#
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.
# All others are server-only.

# ── Site URL ──────────────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_SITE_URL   Canonical origin of the site, used for OG/SEO tags,
#                        sitemaps, and absolute URL construction.
#                        Set to the primary production domain on production;
#                        set to the Vercel deployment URL on staging.
#
#                        Example:
#                          https://misterchameleon.com         (production)
#                          https://mister-chameleon.vercel.app (staging)

# NEXT_PUBLIC_SITE_URL=https://misterchameleon.com

# ── Supabase ──────────────────────────────────────────────────────────────────
#
# REQUIRED — the app will not start without these.
#
# NEXT_PUBLIC_SUPABASE_URL        Your Supabase project URL.
#                                 Found in Settings → API → Project URL.
#
# NEXT_PUBLIC_SUPABASE_ANON_KEY   Public anon key (safe to expose to browser).
#                                 Found in Settings → API → Project API keys.
#
# SUPABASE_SERVICE_ROLE_KEY       Secret service-role key (server-only).
#                                 Found in Settings → API → Project API keys.
#                                 Never expose this to the browser.
#                                 Required for all server-side DB writes (sessions,
#                                 events, tenant_settings, rules_config, pages).
#
# After setting these, apply the Supabase migrations to create all required tables:
#   npx supabase db push   (or paste each file into the Supabase dashboard SQL editor)
#
# Migration files are in supabase/migrations/ — apply them in filename order.
# Key tables created by migrations include:
#   form_submissions          — stores validated form submissions
#   tenant_form_settings      — per-tenant form configuration (storage, notify, confirm)
#   tenant_email_transport    — per-tenant email transport override (Resend / SMTP)

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Sanity CMS ────────────────────────────────────────────────────────────────
#
# Optional — when SANITY_PROJECT_ID is absent the app automatically falls back
# to MockCMSProvider (built-in demo content).  Set these vars to load real
# hero/proof/CTA variant content from your Sanity project.
#
# When SANITY_PROJECT_ID IS set, SANITY_DATASET and SANITY_API_VERSION become
# required and the app will fail clearly if they are missing.
#
# SANITY_PROJECT_ID     Your Sanity project ID.
#                       Found at manage.sanity.io → Settings → API.
#
# SANITY_DATASET        Content dataset name. Almost always "production".
#
# SANITY_API_VERSION    Sanity API version date string. Use the date you
#                       generated the client, e.g. "2024-01-01".
#
# SANITY_READ_TOKEN     Optional. Adds a read token for draft/preview content.
#                       Not needed for published content via the CDN.
#
# SANITY_API_WRITE_TOKEN  Required for the CMS provisioning flow
#                         (/admin/tenants/[id] → "Provision CMS" button).
#                         Create a token with Write access in Sanity:
#                           manage.sanity.io → Settings → API → Tokens → Add API Token
#                         Keep this server-only — never expose to the browser.

# SANITY_PROJECT_ID=your-project-id
# SANITY_DATASET=production
# SANITY_API_VERSION=2024-01-01
# SANITY_READ_TOKEN=your-read-token
# SANITY_API_WRITE_TOKEN=your-write-token

# ── Storyblok CMS ─────────────────────────────────────────────────────────────
#
# Alternative CMS option. Used when SANITY_PROJECT_ID is absent.
# When both SANITY_PROJECT_ID and STORYBLOK_ACCESS_TOKEN are absent,
# the app automatically falls back to MockCMSProvider.
#
# Provider selection priority:
#   SANITY_PROJECT_ID set        →  SanityProvider      (first priority)
#   STORYBLOK_ACCESS_TOKEN set   →  StoryblokProvider   (second priority)
#   Neither set                  →  MockCMSProvider     (fallback / local dev)
#
# STORYBLOK_ACCESS_TOKEN   Required. Content Delivery API token (read-only).
#                          Found in your Storyblok space under Settings → Access Tokens.
#
# STORYBLOK_REGION         Optional. CDN region to use.
#                          Accepts: eu | us | ap | ca | cn
#                          Default: eu
#
# STORYBLOK_VERSION        Optional. Content version to fetch.
#                          Accepts: published | draft
#                          Default: published

# STORYBLOK_ACCESS_TOKEN=your-access-token
# STORYBLOK_REGION=eu
# STORYBLOK_VERSION=published

# ── Statamic CMS ──────────────────────────────────────────────────────────────
#
# Third CMS option. Used when SANITY_PROJECT_ID and STORYBLOK_ACCESS_TOKEN are
# both absent.
#
# STATAMIC_API_URL    Required. Base URL of Statamic site (no trailing slash).
#                     Example: https://cms.example.com
#
# STATAMIC_API_KEY    Optional. Bearer token for protected APIs. Also the shared
#                     secret for the CMS write route — must equal
#                     MISTER_CHAMELEON_CMS_WRITE_TOKEN in the Statamic app's .env.
#
# STATAMIC_CMS_PATH   Local dev only. Path to the Statamic app directory, relative
#                     to this project root. Enables the file-based fallback: when
#                     the HTTP API 404s or does not parse (common locally due to
#                     PHP routing conflicts), the client reads the flat YAML files
#                     straight from disk — no PHP server needed.
#                     Never set this on Vercel (the directory does not exist there).

# STATAMIC_API_URL=https://cms.example.com
# STATAMIC_API_KEY=your-api-key
# STATAMIC_CMS_PATH=../mister-chameleon-cms-app

# ── Tenant configuration ──────────────────────────────────────────────────────
#
# MC_FALLBACK_TENANT_ID   Optional. tenantId to use when the incoming hostname
#                         is not in the static TENANT_REGISTRY.
#
#                         Essential on staging deployments where the custom
#                         domain is not yet provisioned — all traffic arrives on
#                         a *.vercel.app preview URL that has no registry entry.
#
#                         Must match a tenantId registered in
#                         tenant/resolve-tenant.ts (e.g. "workengine").
#                         Defaults to "mister-chameleon" when absent.

# MC_FALLBACK_TENANT_ID=workengine

# ── Decision Provider ─────────────────────────────────────────────────────────
#
# MC_HOMEPAGE_DECISION_PROVIDER   Controls which engine resolves the live
#                                 homepage experience plan.
#
#   rules   — Rule-based evaluation via HOMEPAGE_RULES. Zero latency, no API
#             keys required. Recommended for staging and MVP production.
#
#   claude  — Anthropic Claude runs live. Uses ConfidenceGatedDecisionProvider:
#             if Claude's confidence >= MC_AI_CONFIDENCE_THRESHOLD, its plan
#             is served. Otherwise, rules takes over. Requires ANTHROPIC_API_KEY.
#
#   openai  — Same as "claude" but calls OpenAI. Requires OPENAI_API_KEY.
#
# MC_AI_CONFIDENCE_THRESHOLD   Minimum model confidence (0–1) for an AI
#                              decision to be served live.
#                              Default: 0.7. Ignored when provider is "rules".
#
# DECISION_PROVIDER            Legacy alias. Used when MC_HOMEPAGE_DECISION_PROVIDER
#                              is absent. Being phased out.

MC_HOMEPAGE_DECISION_PROVIDER=rules
# MC_AI_CONFIDENCE_THRESHOLD=0.7

# ── OpenAI (required when DECISION_PROVIDER=openai) ──────────────────────────

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# ── Anthropic Claude (required when DECISION_PROVIDER=claude) ────────────────
#
# ANTHROPIC_API_KEY    Required. Your Anthropic API key (starts with sk-ant-).
#                      Get one at https://console.anthropic.com/
#
# CLAUDE_MODEL         Optional. Default: claude-3-5-haiku-20241022
#                      Haiku is recommended: fast, cheap, strong instruction following.
#
# CLAUDE_DECISION_TIMEOUT  Optional. Request timeout in ms. Default: 8000.
#                          Keep below Next.js edge timeout (10s).

# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-haiku-20241022
# CLAUDE_DECISION_TIMEOUT=8000

# ── Shadow Mode ───────────────────────────────────────────────────────────────
#
# When enabled, an AI provider runs in parallel with the live rules engine.
# The rendered page is ALWAYS the live (rules) plan — shadow mode is for
# model evaluation only.  Logs to ai_decision_logs via Next.js after().
#
# SHADOW_AI_ENABLED    Set to "true" to enable. Requires Supabase + AI API key.
# SHADOW_AI_PROVIDER   "claude" (requires ANTHROPIC_API_KEY) or "openai".

# SHADOW_AI_ENABLED=true
# SHADOW_AI_PROVIDER=claude

# ── Automation (n8n) ──────────────────────────────────────────────────────────
#
# Optional. When absent, webhook calls are skipped silently.
#
# N8N_CONTACT_WEBHOOK_URL   Webhook URL for contact form submissions.
#                           Example: https://your-n8n.example.com/webhook/abc123

# N8N_CONTACT_WEBHOOK_URL=https://your-n8n.example.com/webhook/...

# ── Email transport ───────────────────────────────────────────────────────────
#
# Form submission emails (backoffice notifications + submitter confirmations)
# use one of two transport options.  Pick whichever you have available.
# When both are absent, email sending is silently skipped — forms still submit
# and store normally.
#
# Transport resolution order (highest priority first):
#   1. Per-tenant override configured in Admin → Forms → Email Transport
#   2. SMTP_HOST set here                    → SMTP transport
#   3. RESEND_API_KEY set here               → Resend transport
#   4. Neither set                           → email skipped, warning logged
#
# ── Option A: Resend (recommended for new setups) ─────────────────────────────
#
# RESEND_API_KEY    Resend API secret key.
#                   Get one at https://resend.com/api-keys
#                   Example: re_xxxxxxxxxxxxxxxxxxxx
#
# ── Option B: SMTP ────────────────────────────────────────────────────────────
#
# SMTP_HOST     Server hostname, e.g. "smtp.mailgun.org" or "smtp.gmail.com".
#               When set, SMTP takes priority over RESEND_API_KEY.
#
# SMTP_PORT     Server port. Default: 587 (STARTTLS).
#               Use 465 for implicit SSL (set SMTP_SECURE=true).
#               Use 25 for unauthenticated relay (unusual).
#
# SMTP_USER     Auth username (usually your email address or API login).
#
# SMTP_PASS     Auth password or app password.
#               NOTE: stored only in this env file, never in the database
#               unless you configure a per-tenant override in the admin UI.
#
# SMTP_SECURE   Set to "true" for port 465 implicit TLS.
#               Leave unset (or "false") for port 587 STARTTLS (recommended).
#
# SMTP_FROM     Optional sender address override for SMTP.
#               If absent, falls back to MAIL_FROM_ADDRESS.
#               Format: "Display Name <address@example.com>" or "address@example.com"
#
# ── Shared email settings ─────────────────────────────────────────────────────
#
# MAIL_FROM_ADDRESS   Default "From" address used by both Resend and SMTP.
#                     Format: "Display Name <address@example.com>"
#                     Must be a verified sender domain on Resend.
#
# BACKOFFICE_EMAIL    Platform-level fallback recipient for form submission
#                     notifications.  Used when a tenant has not configured
#                     per-tenant recipients in Admin → Forms → Settings.
#                     Example: ops@yourcompany.com
#
# ── Per-tenant email transport secret encryption ──────────────────────────────
#
# EMAIL_ENCRYPTION_KEY  Optional. 32-byte hex key (64 hex chars) used to
#                       encrypt SMTP passwords and Resend API keys stored in
#                       the tenant_email_transport database table.
#
#                       When absent, secrets are stored with a "plain:" prefix
#                       (still functional, just not encrypted at rest).
#                       Set this before any tenant configures a per-tenant
#                       transport so secrets are encrypted from the start.
#
#                       Generate with:
#                         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#                       IMPORTANT: Never change this key once secrets are stored
#                       — existing ciphertext cannot be decrypted with a new key.
#
# ── IP→company cache key hash ─────────────────────────────────────────────────
#
# IP_HASH_KEY           Optional. 32-byte hex key (64 hex chars) used to key the
#                       one-way digest that keys the ip_company_cache table, so
#                       raw visitor IPs are never stored (lib/ip-hash.ts). Company
#                       firmographics stay plaintext — only the key is hashed.
#
#                       When absent, the digest falls back to unkeyed SHA-256
#                       (still functional, just not unforgeable). Set this in
#                       production so an attacker cannot confirm whether a given
#                       IP is cached.
#
#                       Generate with:
#                         node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
#                       Changing it makes existing cache rows read as misses (they
#                       re-query and refill within the freshness window) — safe,
#                       but a paid Leadinfo re-lookup for warm IPs until refilled.
#
# IP_HASH_KEY=

# RESEND_API_KEY=re_...
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@mg.example.com
# SMTP_PASS=your-smtp-password
# SMTP_SECURE=false
# SMTP_FROM=Mister Chameleon <hello@example.com>
# MAIL_FROM_ADDRESS=Mister Chameleon <hello@example.com>
# BACKOFFICE_EMAIL=ops@example.com
# EMAIL_ENCRYPTION_KEY=


# ── Admin Panel Auth ──────────────────────────────────────────────────────────
#
# ADMIN_SESSION_SECRET   REQUIRED. Secret key used to sign and verify admin
#                        session JWTs (HS256).  Must be at least 32 characters.
#                        Generate with: openssl rand -hex 32
#                        Must be set in Vercel → Project Settings → Environment
#                        Variables for preview and production deployments.
#
# ADMIN_TOTP_ISSUER      Optional. Issuer name shown in authenticator apps when
#                        admins set up 2FA.  Defaults to "Admin" when absent.
#                        Example: "Mister Chameleon"

ADMIN_SESSION_SECRET=replace-with-openssl-rand-hex-32-output
# ADMIN_TOTP_ISSUER=Mister Chameleon

# ── Vercel (domain management) ────────────────────────────────────────────────
#
# Required only for the domain management feature in the admin panel
# (/admin/tenants/[id] → Domains tab).  The app functions without these vars
# — domain CRUD operations will return an error if they are absent.
#
# VERCEL_API_TOKEN    Personal Access Token or Team token with project scope.
#                     Create at: vercel.com/account/tokens
#
# VERCEL_PROJECT_ID   Your Vercel project ID.
#                     Found at: vercel.com/[team]/[project]/settings → General
#
# VERCEL_TEAM_ID      Your Vercel team ID (starts with "team_").
#                     Found at: vercel.com/[team]/settings → General
#                     Leave blank if using a personal account.

# VERCEL_API_TOKEN=your-vercel-api-token
# VERCEL_PROJECT_ID=prj_...
# VERCEL_TEAM_ID=team_...

# ── Cloudflare R2 (asset storage) ─────────────────────────────────────────────
#
# Optional — the platform falls back to Supabase Storage or Sanity Assets
# when these vars are absent.  Configure these to enable Cloudflare R2 as the
# asset storage backend (zero egress fees within Cloudflare network).
#
# R2_ACCOUNT_ID        Your Cloudflare account ID.
#                      Found at: dash.cloudflare.com → right sidebar (Account ID).
#
# R2_ACCESS_KEY_ID     R2 API token Access Key ID.
#                      Create at: dash.cloudflare.com → R2 → API tokens.
#                      Token must have: Object Read & Write on the target bucket.
#
# R2_SECRET_ACCESS_KEY R2 API token Secret Access Key (shown once on creation).
#
# R2_BUCKET_NAME       Name of the R2 bucket (e.g. "mister-chameleon-assets").
#                      Create the bucket first in the Cloudflare dashboard.
#
# R2_PUBLIC_URL        Public base URL for asset delivery.
#                      Built-in subdomain: https://pub-<hash>.r2.dev
#                        (Enable "Public access" on the bucket in R2 dashboard.)
#                      Custom domain:     https://assets.yourdomain.com
#                        (Add a Cloudflare custom domain on the R2 bucket.)
#                      The URL must NOT have a trailing slash.
#
# Manual Cloudflare R2 setup steps:
#   1. Go to dash.cloudflare.com → R2 → Create bucket
#   2. Name the bucket (e.g. "mister-chameleon-assets")
#   3. Enable "Public access" on the bucket (Settings → Public access)
#   4. Copy the "S3 API" endpoint and public URL from the bucket overview
#   5. Go to R2 → API tokens → Create token
#      - Permissions: Object Read & Write
#      - Bucket: select your bucket
#   6. Copy the Access Key ID and Secret Access Key into your .env.local
#
# Alternatively, credentials can be saved via Admin → Platform → Integrations → Storage.

# R2_ACCOUNT_ID=abc123def456abc123def456abc12345
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=mister-chameleon-assets
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Ad-audience sync / Retargeting ────────────────────────────────────────────
#
# Pushes Lead Base segments into Google Ads Customer Match, Meta Custom Audiences
# and LinkedIn Matched Audiences (see lib/ad-sync/ and lib/ad-sync/README.md).
#
# There are NO env vars for this feature: all ad-platform credentials are stored
# per-tenant and entered in the admin UI at
#   Admin → Tenants → [tenant] → Doelgroepen → Retargeting.
#
# The only requirement is the shared cron secret below (already used by the other
# crons). It gates the daily reconcile job at /api/cron/ad-sync (vercel.json
# schedule "30 3 * * *"). On Vercel this is injected automatically; set it here
# for local/staging so the cron endpoint is authenticated.

# CRON_SECRET=generate-a-long-random-string
