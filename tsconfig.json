{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    // De scripts in scripts/ draaien via `node --experimental-strip-types`, dat
    // import-paden letterlijk resolvet: een `.js`-import naar een `.ts`-bestand
    // faalt met ERR_MODULE_NOT_FOUND (bewezen op Node 22.23 in CI, 18 juli 2026,
    // toen de release-job voor het eerst draaide). Daarom importeren die scripts
    // hun buren met een .ts-extensie. Deze vlag staat dat toe voor tsc; hij eist
    // niets af (de app-code gebruikt gewoon @/-aliassen zonder extensie) en is
    // toegestaan omdat noEmit aan staat.
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "apps",
    // Build artifacts and archives — not source, and their errors are not ours.
    //
    // `include` is "**/*.ts", so without these tsc typechecks a built Storybook
    // bundle and Sanity schemas from a backup taken in April. Two of the 44
    // errors in the first honest `npm run typecheck` came from backups/.
    // ESLint had exactly the same blind spot, and there it was worse:
    // storybook-static/ supplied all 354 of its errors and kept CI red for
    // months, over generated code nobody wrote.
    "backups",
    "storybook-static"
  ]
}