{
  "meta": {
    "schema": "mister-chameleon-design-preset@1",
    "id": "healthcare-calm",
    "name": "Healthcare Calm",
    "description": "Healthcare & wellness. Cyan on sky-blue, soft rounded corners, airy and light."
  },
  "theme": "custom",
  "color": {
    "primary": "#0891b2",
    "primaryHover": "#0e7490",
    "secondary": "#34d399",
    "accent": "#ecfeff",
    "background": "#f0f9ff",
    "foreground": "#0c4a6e",
    "muted": "#e0f2fe",
    "mutedForeground": "#0369a1",
    "border": "#bae6fd",
    "card": "#ffffff",
    "cardForeground": "#0c4a6e",
    "onPrimary": "#ffffff",
    "link": "#34d399",
    "success": "#16a34a",
    "danger": "#dc2626",
    "gradient": "linear-gradient(135deg, #0891b2 0%, #34d399 100%)"
  },
  "typography": {
    "fontHeading": "'Manrope', system-ui, sans-serif",
    "fontBody": "'Manrope', system-ui, sans-serif",
    "baseFontSize": "16px",
    "headingWeight": "700",
    "letterSpacing": "0",
    "headingTransform": "none",
    "headingLineHeight": "1.2"
  },
  "radius": {
    "interactive": "16px",
    "card": "20px"
  },
  "shadow": {
    "md": "0 8px 24px rgba(8,145,178,.12)"
  },
  "border": {
    "width": "1px"
  },
  "spacing": {
    "sectionPadding": "clamp(72px,10vw,160px)",
    "container": "72rem",
    "align": "center"
  },
  "component": {
    "buttonPaddingX": "1.3rem",
    "buttonPaddingY": ".7rem"
  },
  "motion": {
    "hoverLift": "-4px"
  },
  "layout": {
    "headerBg": "#ffffff",
    "headerFg": "#0c4a6e",
    "headerBorder": "#bae6fd",
    "navLinkWeight": "600",
    "navLinkTracking": "0"
  },
  "focus": {
    "ringWidth": "3px",
    "ringColor": "#0891b2"
  },
  "swatch": {
    "primary": "#0891b2",
    "background": "#f0f9ff",
    "foreground": "#0c4a6e",
    "accent": "#ecfeff"
  }
}
