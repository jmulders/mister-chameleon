# ── Mister Chameleon — Staging Environment Variables ─────────────────────────
#
# Add these to Vercel → Project Settings → Environment Variables
# and scope them to "Preview" deployments.
#
# For local staging testing: cp .env.staging.example .env.staging.local

# ── Staging URLs ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://staging.misterchameleon.com
MC_FALLBACK_TENANT_ID=workengine

# ── Supabase — STAGING project (separate from production) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...staging-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...staging-service-role-key...

# ── Sanity — staging dataset ──────────────────────────────────────────────────
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=staging
SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=your-write-token

# ── Statamic CMS — STAGING instance ───────────────────────────────────────────
# Base URL of the *staging* Statamic CMS host. The frontend mappers resolve
# DRAFT asset URLs against this host, so it MUST be a staging CMS, not production
# (the Live Preview path also passes the per-tenant base explicitly — see
# docs/cms-pipeline.md). Per-tenant: set to the staging CMS of the tenant this
# deployment primarily serves.
STATAMIC_API_URL=https://cms.staging.misterchameleon.nl

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SESSION_SECRET=your-staging-admin-session-secret-min-32-chars

# ── Decision engine ───────────────────────────────────────────────────────────
MC_HOMEPAGE_DECISION_PROVIDER=rules

# ── Email — staging uses a test mailbox ───────────────────────────────────────
RESEND_API_KEY=re_staging_key
MAIL_FROM_ADDRESS=Mister Chameleon Staging <staging@misterchameleon.com>
BACKOFFICE_EMAIL=dev@misterchameleon.com

# ── AI (optional on staging) ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-3-5-haiku-20241022

# ── Stripe — test mode keys ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_test_...
