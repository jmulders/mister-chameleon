# ── Mister Chameleon — Production Environment Variables ──────────────────────
#
# Add these to Vercel → Project Settings → Environment Variables
# and scope them to "Production" deployments.
#
# NEVER commit this file with real values. This is a template only.

# ── Production URLs ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://misterchameleon.com

# ── Supabase — PRODUCTION project ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...production-anon-key...
SUPABASE_SERVICE_ROLE_KEY=eyJ...production-service-role-key...

# ── Sanity — production dataset ───────────────────────────────────────────────
SANITY_PROJECT_ID=your-sanity-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2024-01-01
SANITY_API_WRITE_TOKEN=your-production-write-token

# ── Statamic CMS — PRODUCTION host ────────────────────────────────────────────
# Base URL of the production Statamic CMS. Used by the mappers as the fallback
# base for resolving DRAFT/preview asset URLs (the Live Preview path passes the
# per-tenant base explicitly). Per-tenant — set to the tenant's own cms. host.
# See docs/cms-pipeline.md for the full per-environment matrix.
STATAMIC_API_URL=https://cms.misterchameleon.nl

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_SESSION_SECRET=your-production-admin-session-secret-min-32-chars
ADMIN_TOTP_ISSUER=Mister Chameleon

# ── Decision engine ───────────────────────────────────────────────────────────
MC_HOMEPAGE_DECISION_PROVIDER=rules
# MC_HOMEPAGE_DECISION_PROVIDER=claude  # enable when AI is ready for production

# ── Email — production (Resend recommended) ───────────────────────────────────
RESEND_API_KEY=re_live_...
MAIL_FROM_ADDRESS=Mister Chameleon <hello@misterchameleon.com>
BACKOFFICE_EMAIL=ops@misterchameleon.com
EMAIL_ENCRYPTION_KEY=your-64-char-hex-key

# ── AI ────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-3-5-haiku-20241022

# ── Stripe — live mode keys ───────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_live_...

# ── Vercel ────────────────────────────────────────────────────────────────────
VERCEL_API_TOKEN=your-vercel-token
VERCEL_PROJECT_ID=prj_...
VERCEL_TEAM_ID=team_...

# ── Enrichment ────────────────────────────────────────────────────────────────
# Add your enrichment provider API keys here.
